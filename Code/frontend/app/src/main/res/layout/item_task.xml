<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/md_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTaskRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Checkbox (EXISTING ID: cbTaskCompleted) — far left -->
        <CheckBox
            android:id="@+id/cbTaskCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/md_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:scaleX="1.2"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Task Title (EXISTING ID: tvTaskTitle) — to the right of checkbox -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp"
            tools:text="Study Chapter 5"
            app:layout_constraintBottom_toTopOf="@+id/iv_calendar"
            app:layout_constraintEnd_toStartOf="@+id/chipXp"
            app:layout_constraintStart_toEndOf="@id/cbTaskCompleted"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Calendar icon — below title, aligned to title start -->
        <ImageView
            android:id="@+id/iv_calendar"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Due date"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:visibility="gone"
            app:tint="#757575"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cbTaskCompleted"
            app:layout_constraintTop_toBottomOf="@id/tvTaskTitle" />

        <!-- Due Date text — to the right of calendar icon -->
        <TextView
            android:id="@+id/tv_due_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif"
            android:textColor="#757575"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Tomorrow"
            app:layout_constraintBottom_toBottomOf="@id/iv_calendar"
            app:layout_constraintEnd_toStartOf="@id/chipXp"
            app:layout_constraintStart_toEndOf="@id/iv_calendar"
            app:layout_constraintTop_toTopOf="@id/iv_calendar" />

        <!-- XP Tag — far right -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10 XP"
            android:textColor="@color/md_on_primary_container"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/md_primary_container"
            app:chipCornerRadius="12dp"
            app:chipMinHeight="26dp"
            app:chipMinTouchTargetSize="0dp"
            app:chipStrokeWidth="0dp"
            app:ensureMinTouchTargetSize="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TouchTargetSizeCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutClassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp"
    android:minHeight="76dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/md_on_background"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvClassMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="13sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnClassNotes"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_metric_tile"
        android:contentDescription="Open class notes"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="@color/md_primary" />

    <ImageButton
        android:id="@+id/btnDeleteClass"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_metric_tile"
        android:contentDescription="Delete class"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@color/md_on_surface_variant" />

</LinearLayout>
